# Copia este archivo a .env.local y llénalo. `npm run instalar` completa lo que
# puede (IDs de campos y secreto del panel). En Vercel van las mismas variables.

# ─── GoHighLevel (obligatorio) ───────────────────────────────────────────────
# Private Integration Token de la SUB-CUENTA: Configuración → Integraciones
# privadas → Crear. Permisos: contacts, opportunities, locations (custom
# values y custom fields). Empieza con "pit-".
GHL_API_KEY=
# Location ID de la misma sub-cuenta: Configuración → Perfil de la empresa.
GHL_LOCATION_ID=

# Los escribe `npm run instalar` al crear los campos de contacto.
GHL_CAMPO_FUENTE_ID=
GHL_CAMPO_FECHA_CLASE_ID=

# Etiqueta de respaldo si en el panel no hay etiqueta de registro.
GHL_TAG_REGISTRO=registro webinar

# ─── Panel /admin (obligatorio) ──────────────────────────────────────────────
ADMIN_PASSWORD=
# Mínimo 24 caracteres. `npm run instalar` lo genera si falta.
ADMIN_SESSION_SECRET=

# ─── Teléfonos ───────────────────────────────────────────────────────────────
# Lada que se asume cuando el número llega sin +. 52 México, 34 España, 57 Colombia…
LADA_POR_DEFECTO=52

# ─── Copia de seguridad en Vercel (recomendado) ──────────────────────────────
# Sin esto el sitio funciona, pero lee GHL en cada visita y si GHL no responde
# muestra valores por defecto. Con esto, las páginas leen una copia en el edge.
# 1) Vercel → Storage → Create → Edge Config → conectarlo al proyecto:
#    EDGE_CONFIG se crea solo. 2) EDGE_CONFIG_ID es el "ecfg_..." del panel.
# 3) VERCEL_API_TOKEN: Account → Tokens (márcalo Sensitive). 4) VERCEL_TEAM_ID:
#    Team settings → General (o vacío si es cuenta personal).
EDGE_CONFIG=
EDGE_CONFIG_ID=
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# Zoom de último recurso si GHL y la copia fallan justo a la hora de la clase.
ENLACE_SALA_RESPALDO=

# ─── Mercado Pago (para que los pagos lleguen a "Cliente Ganado") ────────────
# Credencial de producción de tu app: Tus integraciones → la app → Producción.
MP_ACCESS_TOKEN=
# Clave secreta que MP genera al guardar el webhook (Webhooks → Configurar).
# URL a registrar: https://TU-DOMINIO/api/pago/mercadopago · evento: Pagos
MP_WEBHOOK_SECRET=

# ─── Pipeline (opcional) ─────────────────────────────────────────────────────
# Por defecto se busca el pipeline "Webinars" con las etapas Nuevo Registro,
# Asistió al Webinar, Cliente Potencial y Cliente Ganado. Cambia el nombre aquí
# o fija los IDs a mano si prefieres.
GHL_PIPELINE_NOMBRE=Webinars
# GHL_PIPELINE_ID=
# GHL_ETAPA_REGISTRO=
# GHL_ETAPA_ASISTIO=
# GHL_ETAPA_POTENCIAL=
# GHL_ETAPA_GANADO=
